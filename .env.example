# Шаблон настроек AI-Scientist. Скопируйте в .env и заполните.
#   cp .env.example .env

# --- API-ключи (заполните хотя бы один) ---
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# S2_API_KEY=

# --- Модели ---
# Модель по умолчанию для тестов.
# Пусто = автоматически выбрать лучшую бесплатную модель из ЖИВОГО каталога
# OpenRouter (бесплатные списки меняются; актуальный — в TUI, /models).
AISC_DEFAULT_MODEL=
# Пример явной фиксации (сверьте наличие с /models):
# AISC_DEFAULT_MODEL=openrouter/google/gemma-4-26b-a4b-it:free
# Модель дискуссий (пусто = AISC_DEFAULT_MODEL)
AISC_DISCUSS_MODEL=
# Модель рецензий (пусто = авто: OpenAI если есть ключ, иначе основная модель)
AISC_REVIEW_MODEL=
# --- Роли моделей (model_router): план / код / ревью ---
# Пусто = автовыбор по живому каталогу (см. /models в TUI); override любого уровня
# AISC_MODEL_PLAN=
# AISC_MODEL_CODE=openrouter/qwen/qwen3-coder:free   # пример; сверяйте с каталогом
# off = не выбирать модели из каталога автоматически (только явные AISC_MODEL_*)
AISC_AUTO_MODELS=on
# Платные модели в автовыборе (1) + потолок цены $/1M (prompt+completion) и
# минимальный контекст кандидата (план/ревью дополнительно требуют >=32k)
# AISC_ALLOW_PAID=1
# AISC_MODEL_PRICE_CAP=10
# AISC_MODEL_MIN_CTX=16384
# Живой веб-discovery через Tavily: "best cheap smart model for <role>" -> валидация
# по каталогу OpenRouter -> буст ранжирования (кэш 24ч). Без ключа — чистый
# каталог (детерминированно). off — даже с ключом.
# TAVILY_API_KEY=
AISC_MODEL_WEB_DISCOVERY=on

# --- Защита от зацикливаний (loop_guard) ---
AISC_LLM_MAX_TRIES=8
AISC_STAGE_MAX_FAILURES=3
AISC_MAX_REPEAT_SIGNATURES=3
AISC_INTERACTIVE=auto        # auto | yes | no
AISC_ON_LIMIT=ask            # ask | continue | skip | abort
AISC_EXTEND_BY=5
AISC_MAX_STAGE_MINUTES=0     # 0 = без лимита времени
# Действие при лимите в headless-режиме (stdin не TTY): skip | abort
AISC_HEADLESS_ON_LIMIT=skip

# --- Research quality ---
# RNG seed for reproducibility (empty = random)
AISC_SEED=
# Comma-separated seeds for multi-seed aggregation (empty = single seed)
AISC_EXP_SEEDS=
# Review fix loop: max iterations to improve paper score
AISC_REVIEW_FIX_ITER=0
# Minimum review score to accept (1-10 scale)
AISC_REVIEW_MIN_SCORE=
# Max minutes for idea generation (0 = unlimited)
AISC_IDEA_BUDGET_MINUTES=0

# --- Obsidian ---
# Path to vault (Windows ok, e.g. C:\Users\<user>\Documents\MyVault)
OBSIDIAN_VAULT_PATH=
# Subfolder for notes inside vault
AISC_OBSIDIAN_ROOT=AI/AI-Scientist

# --- Runner / TUI ---
# Python used by the TUI to spawn pipeline jobs (empty = "python" from PATH).
# Windows venv example: C:\path\to\AI-Scientist\.venv\Scripts\python.exe
AISC_PYTHON=
# Ollama server for ollama/* models (default http://localhost:11434).
# /doctor probes it when AISC_DEFAULT_MODEL points at ollama.
# OLLAMA_HOST=

# Шаблон настроек AI-Scientist. Скопируйте в .env и заполните.
#   cp .env.example .env

# --- API-ключи (заполните хотя бы один) ---
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# S2_API_KEY=

# --- Модели ---
# Модель по умолчанию для тестов (бесплатная на OpenRouter)
AISC_DEFAULT_MODEL=openrouter/z-ai/glm-5.2:free
# Модель дискуссий (пусто = AISC_DEFAULT_MODEL)
AISC_DISCUSS_MODEL=
# Модель рецензий (пусто = авто: OpenAI если есть ключ, иначе основная модель)
AISC_REVIEW_MODEL=

# --- Защита от зацикливаний (loop_guard) ---
AISC_LLM_MAX_TRIES=8
AISC_STAGE_MAX_FAILURES=3
AISC_MAX_REPEAT_SIGNATURES=3
AISC_INTERACTIVE=auto        # auto | yes | no
AISC_ON_LIMIT=ask            # ask | continue | skip | abort
AISC_EXTEND_BY=5
AISC_MAX_STAGE_MINUTES=0     # 0 = без лимита времени
# Действие при лимите в headless-режиме (stdin не TTY): skip | abort
AISC_HEADLESS_ON_LIMIT=skip

# --- Research quality ---
# RNG seed for reproducibility (empty = random)
AISC_SEED=
# Comma-separated seeds for multi-seed aggregation (empty = single seed)
AISC_EXP_SEEDS=
# Review fix loop: max iterations to improve paper score
AISC_REVIEW_FIX_ITER=0
# Minimum review score to accept (1-10 scale)
AISC_REVIEW_MIN_SCORE=
# Max minutes for idea generation (0 = unlimited)
AISC_IDEA_BUDGET_MINUTES=0

# --- Obsidian ---
# Path to vault (Windows ok, e.g. C:\Users\<user>\Documents\MyVault)
OBSIDIAN_VAULT_PATH=
# Subfolder for notes inside vault
AISC_OBSIDIAN_ROOT=AI/AI-Scientist
